<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CASCADE Out Of Stock</title>
  <style>
    :root {
      --green: #047857;
      --green-dark: #065f46;
      --green-soft: #ecfdf5;
      --table-header-gradient: linear-gradient(180deg, #d8f3e6 0%, #a9dfc6 100%);
      --row-alt-gradient: linear-gradient(90deg, #ffffff 0%, #f7fbff 100%);
      --row-active-gradient: linear-gradient(90deg, #f7fffb 0%, #e4faef 100%);
      --ink: #17212f;
      --muted: #667085;
      --line: #d9e0e8;
      --soft: #f6f8fa;
      --app-bg: #f6f8f7;
      --panel: #ffffff;
      --red: #c24132;
      --red-soft: #fff1f0;
      --shadow: 0 18px 44px rgba(23, 33, 47, 0.14);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    [hidden] {
      display: none !important;
    }

    body {
      margin: 0;
      min-width: 320px;
      color: var(--ink);
      background: var(--app-bg);
      background-attachment: fixed;
      background-size: cover;
  background-position: center bottom;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    .app-shell {
      min-height: 100vh;
      padding-bottom: 130px;
    }

    .topbar {
      min-height: 64px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 22px;
      padding: 0 24px;
      color: #fff;
      background: #111827;
      box-shadow: 0 2px 8px rgba(6, 95, 70, 0.2);
    }

    .brand {
      display: inline-flex;
      align-items: center;
    }

    .brand-logo {
      width: auto;
      height: 48px;
      max-width: 124px;
      object-fit: contain;
    }

    .main-nav {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      align-self: stretch;
      overflow: visible;
    }

    .main-nav a,
    .main-nav button,
    .profile-button {
      min-height: 44px;
      border: 0;
      border-radius: 8px 8px 0 0;
      padding: 0 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: transparent;
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
    }

    .main-nav a.active,
    .main-nav a:hover,
    .main-nav button.active,
    .main-nav button:hover,
    .nav-more.active>.more-toggle,
    .nav-more:hover>.more-toggle,
    .nav-more:focus-within>.more-toggle {
      color: var(--green);
      background: #fff;
    }

    .main-nav a.active,
    .main-nav button.active,
    .nav-more.active {
      position: relative;
      margin-top: 12px;
    }

    .nav-more {
      position: relative;
      display: inline-flex;
      align-items: flex-end;
    }

    .more-toggle {
      gap: 8px;
    }

    .more-toggle::after {
      content: "";
      width: 0;
      height: 0;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 5px solid currentColor;
    }

    .more-menu {
      position: absolute;
      top: calc(100% - 1px);
      left: 0;
      z-index: 30;
      min-width: 178px;
      display: none;
      flex-direction: column;
      gap: 4px;
      padding: 8px;
      border-radius: 0 0 8px 8px;
      background: #fff;
      box-shadow: 0 16px 34px rgba(15, 23, 42, 0.2);
    }

    .nav-more:hover .more-menu,
    .nav-more:focus-within .more-menu {
      display: flex;
    }

    .main-nav .more-menu a {
      position: static;
      min-height: 38px;
      border-radius: 6px;
      margin-top: 0;
      padding: 0 12px;
      color: var(--ink);
      background: transparent;
    }

    .main-nav .more-menu a:hover,
    .main-nav .more-menu a:focus-visible,
    .main-nav .more-menu a.active {
      color: #fff;
      background: var(--green);
    }

    .profile-button {
      min-height: 36px;
      gap: 8px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #fff;
      background: rgba(255, 255, 255, 0.08);
    }

    .profile-button::after {
      content: "";
      width: 8px;
      height: 8px;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      transform: translateY(-2px) rotate(45deg);
    }

    .account-menu {
      position: relative;
      justify-self: end;
    }

    .account-dropdown {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 60;
      width: min(232px, calc(100vw - 24px));
      display: none;
      flex-direction: column;
      padding: 8px 0;
      border-radius: 8px;
      color: rgba(255, 255, 255, 0.9);
      background: #0f1726;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.28);
    }

    .account-menu.is-open .account-dropdown {
      display: flex;
    }

    .account-dropdown::before {
      content: "";
      position: absolute;
      top: -9px;
      right: 18px;
      width: 18px;
      height: 18px;
      background: #0f1726;
      border-radius: 3px 0 0 0;
      transform: rotate(45deg);
    }

    .account-menu-item {
      min-height: 50px;
      display: flex;
      align-items: center;
      gap: 16px;
      border: 0;
      padding: 0 16px;
      color: rgba(255, 255, 255, 0.86);
      background: transparent;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-align: left;
      text-transform: uppercase;
    }

    .account-menu-item:hover,
    .account-menu-item:focus-visible {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      outline: 0;
    }

    .account-menu-item svg {
      width: 22px;
      height: 22px;
      flex: 0 0 auto;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }

    .account-menu-separator {
      height: 1px;
      margin: 8px 0;
      background: rgba(255, 255, 255, 0.18);
    }

    .workspace {
      max-width: 1420px;
      margin: 0 auto;
      padding: 24px 20px 40px;
    }

    .site-footer {
      margin-top: 22px;
      border-top: 1px solid rgba(217, 224, 232, 0.9);
      padding: 22px 0 2px;
      color: #7a879a;
      font-size: 13px;
      text-align: center;
    }

    .page-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      margin-bottom: 18px;
    }

    .heading-copy {
      display: flex;
      align-items: baseline;
      gap: 14px;
      flex-wrap: wrap;
    }

    h1,
    h2,
    p {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 0;
      font-size: 30px;
      line-height: 1.12;
    }

    h2 {
      margin-bottom: 0;
      font-size: 18px;
      line-height: 1.25;
    }

    .eyebrow {
      margin: 0 0 5px;
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .subheading {
      margin: 0;
      color: var(--muted);
      font-weight: 600;
    }

    .toolbar,
    .orders-table-shell {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
      box-shadow: 0 8px 22px rgba(23, 33, 47, 0.07);
    }

    .toolbar {
      display: grid;
      grid-template-columns: minmax(330px, 1fr) minmax(330px, 1fr) minmax(420px, 1.15fr) auto;
      gap: 22px;
      align-items: end;
      margin-bottom: 18px;
      padding: 16px;
      border-top: 4px solid var(--green);
    }

    .toolbar-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    label {
      display: grid;
      gap: 6px;
    }

    .toolbar label {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 16px;
    }

    label span,
    .meta-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
    }

    input,
    select {
      width: 100%;
      min-height: 44px;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0 12px;
      color: var(--ink);
      background: #fff;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: rgba(4, 120, 87, 0.65);
      box-shadow: 0 0 0 3px rgba(4, 120, 87, 0.12);
    }

    input[type="date"] {
      cursor: pointer;
    }

    .toolbar input,
    .toolbar select {
      min-height: 44px;
    }

    .icon-button {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 0;
      border-radius: 6px;
      color: #fff;
      background: var(--green);
      font-size: 18px;
      font-weight: 900;
    }

    .icon-button.reset {
      color: var(--green-dark);
      border: 1px solid rgba(4, 120, 87, 0.28);
      background: var(--green-soft);
      font-size: 0;
    }

    .icon-button svg {
      width: 21px;
      height: 21px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .orders-table-shell {
      overflow-x: auto;
    }

    .stock-table {
      width: 100%;
      min-width: 1260px;
      border-collapse: separate;
      border-spacing: 0;
    }

    .stock-table th,
    .stock-table td {
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: middle;
    }

    .stock-table th {
      padding: 11px 14px;
      color: #064e3b;
      background: var(--table-header-gradient);
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .stock-table tbody tr {
      height: 48px;
      background: #fff;
      transition: background 120ms ease;
    }

    .stock-table tbody tr:nth-child(odd) {
      background: var(--row-alt-gradient);
    }

    .stock-table td {
      padding: 8px 14px;
      font-size: 13.5px;
    }

    .stock-table th.col-center,
    .stock-table td.col-center {
      text-align: center;
    }

    .stock-table tbody tr:hover,
    .stock-table tbody tr.selected {
      background: var(--row-active-gradient);
    }

    .stock-table tbody tr:last-child td {
      border-bottom: 0;
    }

    .order-id-val {
      font-weight: 700;
      color: #0f172a;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
    }

    .order-date-val {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 13px;
      font-weight: 600;
      color: #1e293b;
      white-space: nowrap;
    }

    .order-date-time {
      font-size: 11.5px;
      font-weight: 500;
      color: var(--muted);
    }

    .action-header,
    .action-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .row-select,
    .select-all {
      width: 18px;
      height: 18px;
      min-height: 18px;
      margin: 0;
      padding: 0;
      accent-color: var(--green);
    }

    .retry-btn {
      min-height: 30px;
      padding: 0 12px;
      border: 1px solid var(--green);
      border-radius: 6px;
      color: #fff;
      background: var(--green);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.3px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 1px 3px rgba(4, 120, 87, 0.15);
      transition: background 150ms ease, box-shadow 150ms ease, transform 100ms ease;
    }

    .retry-btn:hover {
      background: var(--green-dark);
      box-shadow: 0 3px 8px rgba(4, 120, 87, 0.28);
    }

    .retry-btn:active {
      transform: scale(0.97);
    }

    .retry-btn svg {
      width: 12px;
      height: 12px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .oos-age-pill {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.2px;
      white-space: nowrap;
    }

    .oos-age-recent {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }

    .oos-age-medium {
      background: #f1f5f9;
      color: #475467;
      border: 1px solid #e2e8f0;
    }

    .oos-age-old {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    .pip-link {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 700;
      font-size: 13px;
      color: var(--green);
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(4, 120, 87, 0.06);
      border: 1px solid rgba(4, 120, 87, 0.16);
      transition: all 120ms ease;
      white-space: nowrap;
    }

    .pip-link:hover {
      background: rgba(4, 120, 87, 0.15);
      text-decoration: underline;
    }

    .product-name {
      min-width: 280px;
      max-width: 440px;
      line-height: 1.4;
      font-weight: 600;
      color: #0f172a;
      font-size: 13.5px;
    }

    .network-order-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 12.5px;
      font-weight: 600;
      color: #334155;
      padding: 3px 9px;
      border-radius: 6px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      white-space: nowrap;
    }

    .qty-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      height: 26px;
      padding: 0 8px;
      border-radius: 6px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      font-weight: 800;
      font-size: 13px;
      color: #0f172a;
    }

    .activity-pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    }

    .activity-pulse-dot.pulse {
      animation: pulse-green 2s infinite;
    }

    .activity-dot-muted {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #9ca3af;
      display: inline-block;
    }

    @keyframes pulse-green {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
      }
      70% {
        box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .table-strong {
      font-weight: 900;
    }

    .product-name {
      min-width: 300px;
      line-height: 1.35;
    }

    .status-pill {
      min-height: 30px;
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 0 11px;
      color: var(--green-dark);
      background: var(--green-soft);
      font-size: 12px;
      font-weight: 900;
    }

    .table-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-top: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 14px;
      background: #fff;
      font-size: 15px;
    }

    .entries-control {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--ink);
      font-size: 13px;
      font-weight: 500;
      white-space: nowrap;
    }

    .entries-control span {
      color: var(--ink);
      font-size: 13px;
      font-weight: 500;
      text-transform: none;
    }

    .entries-control select {
      width: auto;
      min-height: 28px;
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0 24px 0 6px;
      color: var(--ink);
      background: #fff;
      font-size: 13px;
    }

    .pagination {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .pagination button {
      min-width: 34px;
      min-height: 34px;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--ink);
      background: #fff;
      font-weight: 900;
    }

    .pagination button.active {
      border-color: var(--green);
      color: #fff;
      background: var(--green);
    }

    .primary-action,
    .danger-action {
      min-height: 42px;
      border: 0;
      border-radius: 6px;
      padding: 0 28px;
      color: #fff;
      font-weight: 900;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .primary-action {
      background: var(--green);
    }

    .danger-action {
      background: var(--red);
    }

    .bottom-bar {
      position: fixed;
      z-index: 50;
      left: 0;
      right: 0;
      bottom: 0;
      border-top: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(8px);
      box-shadow: 0 -10px 28px rgba(23, 33, 47, 0.14);
      transform: translateY(100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease;
    }

    .bottom-bar.is-visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .bottom-bar-inner {
      max-width: 1420px;
      min-height: 76px;
      margin: 0 auto;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .footer-selected-count {
      display: grid;
      gap: 5px;
      color: var(--green-dark);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .footer-selected-count strong {
      color: var(--ink);
      font-size: 16px;
      text-transform: none;
    }

    .bottom-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
    }

    .empty-state {
      border: 1px dashed var(--line);
      border-radius: 8px;
      padding: 34px;
      text-align: center;
      background: #fff;
    }

    .toast-region {
      position: fixed;
      z-index: 90;
      top: 18px;
      right: 18px;
      display: grid;
      gap: 10px;
    }

    .toast {
      width: min(360px, calc(100vw - 36px));
      border-left: 4px solid var(--green);
      border-radius: 8px;
      padding: 14px 16px;
      background: #fff;
      box-shadow: var(--shadow);
      font-weight: 800;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    dialog {
      border: 0;
      padding: 0;
      background: transparent;
    }

    dialog::backdrop {
      background: rgba(17, 24, 39, 0.48);
    }

    .modal-panel {
      width: min(440px, calc(100vw - 32px));
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      box-shadow: var(--shadow);
    }

    .modal-panel.small {
      width: min(440px, calc(100vw - 32px));
    }

    .modal-header,
    .modal-body,
    .modal-footer {
      padding: 18px 22px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      border-bottom: 1px solid var(--line);
    }

    .modal-body {
      display: grid;
      gap: 12px;
      background: #f8fafc;
      text-align: center;
    }

    .modal-footer {
      display: flex;
      justify-content: center;
      gap: 10px;
      border-top: 1px solid var(--line);
    }

    .warning-icon {
      width: 70px;
      height: 70px;
      display: grid;
      place-items: center;
      margin: 0 auto 12px;
      border: 3px solid #ffb982;
      border-radius: 999px;
      color: #ff9d57;
      font-size: 42px;
      font-weight: 300;
      line-height: 1;
    }

    .secondary-action {
      min-height: 42px;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0 28px;
      color: var(--ink);
      background: #fff;
      font-weight: 900;
      text-transform: uppercase;
    }

    .icon-close {
      width: 36px;
      height: 36px;
      flex: 0 0 auto;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      background: #fff;
      font-size: 24px;
      line-height: 1;
    }

    .detail-card {
      display: grid;
      gap: 4px;
      min-height: 62px;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      background: #fff;
    }

    .detail-card.product {
      border-color: rgba(4, 120, 87, 0.18);
      background: #fbfefd;
    }

    .quantity-stepper {
      display: grid;
      grid-template-columns: 44px minmax(64px, 1fr) 44px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
    }

