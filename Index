    function visibleLines() {
      const startDate = parseDateInput(els.startDate.value);
      const endDate = parseDateInput(els.endDate.value);
      return stockLines.filter((line) => {
        const lineDate = parseStockLineDate(line.date);
        const statusPasses = state.status === "All" || line.status === state.status;
        const startPasses = !startDate || !lineDate || lineDate >= startDate;
        const endPasses = !endDate || !lineDate || lineDate <= endDate;
        return statusPasses && startPasses && endPasses;
      });
    }

    function parseDateInput(value) {
      if (!value) return null;
      const [year, month, day] = value.split("-").map(Number);
      if (!year || !month || !day) return null;
      return new Date(year, month - 1, day);
    }

    function parseStockLineDate(value) {
      const [day, month, year] = String(value || "").split(" - ")[0].split("-").map(Number);
      if (!year || !month || !day) return null;
      return new Date(year, month - 1, day);
    }

    function render() {
      const rows = visibleLines();
      const total = rows.length;
      state.selectedIds = state.selectedIds.filter((id) => rows.some((line) => line.lineId === id));
      const count = state.selectedIds.length;
      els.selectedLinesCount.textContent = `${count} line${count === 1 ? "" : "s"} selected`;

      const bottomBar = document.querySelector("#bottomBar");
      const addToOrderLabel = document.querySelector("#addToOrderLabel");
      if (bottomBar) {
        if (count > 0) {
          bottomBar.classList.add("is-visible");
          if (addToOrderLabel) {
            addToOrderLabel.textContent = `Add ${count} Selected Line${count === 1 ? "" : "s"} to Order Pad`;
          }
        } else {
          bottomBar.classList.remove("is-visible");
        }
      }

      renderTable(rows);
    }

    function renderTable(rows) {
      const pageCount = Math.max(1, Math.ceil(rows.length / state.pageSize));
      state.currentPage = Math.min(state.currentPage, pageCount);
      const start = (state.currentPage - 1) * state.pageSize;
      const pageRows = rows.slice(start, start + state.pageSize);
      els.emptyState.hidden = rows.length > 0;
      const visibleIds = pageRows.map((line) => line.lineId);
      const allVisibleSelected = visibleIds.length > 0 && visibleIds.every((id) => state.selectedIds.includes(id));
      const someVisibleSelected = visibleIds.some((id) => state.selectedIds.includes(id));
      els.stockGrid.innerHTML = rows.length
        ? `
            <table class="stock-table">
              <thead>
                <tr>
                  <th class="col-center" style="width: 44px; padding: 11px 4px;">
                    <input class="select-all" type="checkbox" data-select-all-visible ${allVisibleSelected ? "checked" : ""} title="Select all lines" aria-label="Select all lines" />
                  </th>
                  <th style="width: 100px;">Action</th>
                  <th style="width: 105px;">Order ID</th>
                  <th style="width: 155px;">Your Order Date</th>
                  <th class="col-center" style="width: 145px;">Out Of Stock Age</th>
                  <th style="width: 110px;">PIP Code</th>
                  <th>Product</th>
                  <th style="width: 150px;">Last Ordered</th>
                  <th class="col-center" style="width: 75px;">Qty</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                ${pageRows.map(stockRowTemplate).join("")}
              </tbody>
            </table>
            ${renderTableFooter(rows.length, state.currentPage, pageCount, "lines")}
          `
        : "";
      const selectAll = els.stockGrid.querySelector("[data-select-all-visible]");
      if (selectAll) selectAll.indeterminate = someVisibleSelected && !allVisibleSelected;
    }

    function renderTableFooter(totalCount, currentPage, pageCount, label) {
      const start = (currentPage - 1) * state.pageSize + 1;
      const end = Math.min(totalCount, currentPage * state.pageSize);
      const buttons = Array.from({ length: pageCount }, (_, index) => {
        const page = index + 1;
        return `<button class="${page === currentPage ? "active" : ""}" type="button" data-page="${page}" aria-label="Go to page ${page}">${page}</button>`;
      }).join("");
      return `
          <div class="table-footer">
            <label class="entries-control">
              <span>Show</span>
              <select data-page-size aria-label="Rows per page">
                ${[10, 25, 50, 100].map((size) => `<option value="${size}" ${size === state.pageSize ? "selected" : ""}>${size}</option>`).join("")}
              </select>
              <span>entries</span>
            </label>
            <span>Showing ${start} to ${end} of ${totalCount} ${label}</span>
            <nav class="pagination" aria-label="Pagination">
              <button type="button" data-page="${Math.max(1, currentPage - 1)}" ${currentPage === 1 ? "disabled" : ""} aria-label="Previous page">&lsaquo;</button>
              ${buttons}
              <button type="button" data-page="${Math.min(pageCount, currentPage + 1)}" ${currentPage === pageCount ? "disabled" : ""} aria-label="Next page">&rsaquo;</button>
            </nav>
          </div>
        `;
    }

    function getOosAge(dateStr) {
      const lineDate = parseStockLineDate(dateStr);
      if (!lineDate) return { label: "Recent", cls: "oos-age-recent" };
      const refDate = new Date(2026, 9, 30); // 30-Oct-2026
      const diffDays = Math.max(0, Math.round((refDate - lineDate) / (1000 * 60 * 60 * 24)));
      if (diffDays === 0) return { label: "Today", cls: "oos-age-recent" };
      if (diffDays === 1) return { label: "1 Day Ago", cls: "oos-age-recent" };
      const label = `${diffDays} Days Ago`;
      if (diffDays <= 5) return { label, cls: "oos-age-recent" };
      if (diffDays <= 14) return { label, cls: "oos-age-medium" };
      return { label, cls: "oos-age-old" };
    }

    function stockRowTemplate(line) {
      const selected = state.selectedIds.includes(line.lineId);
      const age = getOosAge(line.date);
      const isTodayActivity = line.lastOrdered && line.lastOrdered.startsWith("Today");
      const statusHtml = line.status === "Above Drug Tariff"
        ? `<span class="status-blocked">Blocked as price above drug tariff. <a href="#" class="call-supplier-link">Call supplier.</a></span>`
        : `<span class="status-oos">Out of Stock</span>`;
      const dateParts = String(line.date || "").split(" - ");
      const dateStr = dateParts[0] || line.date;
      const timeStr = dateParts[1] || "";
      return `
          <tr class="${selected ? "selected" : ""}" data-line-id="${line.lineId}">
            <td class="col-center" style="width: 44px; padding: 8px 4px;">
              <input class="row-select" type="checkbox" data-select-line="${line.lineId}" aria-label="Select line ${line.pip}" ${selected ? "checked" : ""} />
            </td>
            <td>
              <button class="retry-btn" type="button" data-retry-line="${line.lineId}" title="Retry line order">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.19"/>
                </svg>
                Retry
              </button>
            </td>
            <td><span class="order-id-val">${line.orderId}</span></td>
            <td>
              <div class="order-date-val">
                <span>${dateStr}</span>
                ${timeStr ? `<span class="order-date-time">${timeStr}</span>` : ""}
              </div>
            </td>
            <td class="col-center">
              <span class="oos-age-pill ${age.cls}">${age.label}</span>
            </td>
            <td><a href="#" class="pip-link">${line.pip}</a></td>
            <td class="product-name">${escapeHtml(line.product)}</td>
            <td>
              <span class="network-order-badge" title="Latest order request across network branches">
                <span class="${isTodayActivity ? 'activity-pulse-dot pulse' : 'activity-dot-muted'}"></span>
                ${line.lastOrdered || "Recent"}
              </span>
            </td>
            <td class="col-center"><span class="qty-chip">${line.requested}</span></td>
            <td>${statusHtml}</td>
          </tr>
        `;
    }

    function toggleSelected(lineId, checked) {
      state.selectedIds = checked
        ? Array.from(new Set([...state.selectedIds, lineId]))
        : state.selectedIds.filter((id) => id !== lineId);
      render();
    }

    function selectVisible() {
      const rows = visibleLines();
      const start = (state.currentPage - 1) * state.pageSize;
      const visibleIds = rows.slice(start, start + state.pageSize).map((line) => line.lineId);
      const allSelected = visibleIds.length > 0 && visibleIds.every((id) => state.selectedIds.includes(id));
      state.selectedIds = allSelected
        ? state.selectedIds.filter((id) => !visibleIds.includes(id))
        : Array.from(new Set([...state.selectedIds, ...visibleIds]));
      render();
    }

    function toast(message) {
      const node = document.createElement("div");
      node.className = "toast";
      node.textContent = message;
      els.toastRegion.appendChild(node);
      window.setTimeout(() => {
        node.style.opacity = "0";
        node.style.transform = "translateY(-8px)";
        window.setTimeout(() => node.remove(), 180);
      }, 2600);
    }

    function activeLine() {
      return stockLines.find((line) => line.lineId === state.activeLineId);
    }

    function openQuantity(lineId) {
      state.activeLineId = lineId;
      const line = activeLine();
      if (!line) return;
      els.quantityProduct.textContent = line.product;
      const pipEl = document.querySelector("#quantityPip");
      if (pipEl) pipEl.textContent = `PIP Code: ${line.pip}`;
      const prevQtyEl = document.querySelector("#prevQuantityVal");
      const currentQty = Math.max(1, Number(line.requested || 1));
      if (prevQtyEl) prevQtyEl.textContent = `${currentQty} pack${currentQty === 1 ? '' : 's'}`;
      els.quantityInput.value = currentQty;
      els.quantityDialog.showModal();
    }

    function stepQuantity(amount) {
      els.quantityInput.value = Math.max(1, Number(els.quantityInput.value || 1) + amount);
    }

    function saveQuantity() {
      const line = activeLine();
      if (!line) return;
      const newQty = Math.max(1, Number(els.quantityInput.value || 1));
      line.requested = newQty;
      toggleSelected(line.lineId, true);
      els.quantityDialog.close();
      render();
      toast(`Retry queued: ${newQty}x ${line.product} added to Order Pad`);
    }

    function resetFilters() {
      els.startDate.value = defaultFilters.startDate;
      els.endDate.value = defaultFilters.endDate;
      els.statusFilter.value = defaultFilters.status;
      state.status = defaultFilters.status;
      state.selectedIds = [];
      state.currentPage = 1;
      render();
      toast("Filters reset");
    }

    function openDatePicker(input) {
      if (typeof input.showPicker === "function") {
        try {
          input.showPicker();
        } catch (error) {
          // Some browsers only allow showPicker during direct user activation.
        }
      }
    }

    els.statusFilter.addEventListener("change", (event) => {
      state.status = event.target.value;
      state.selectedIds = [];
      state.currentPage = 1;
      render();
    });

    [els.startDate, els.endDate].forEach((input) => {
      input.addEventListener("click", () => openDatePicker(input));
      input.addEventListener("focus", () => openDatePicker(input));
      input.addEventListener("change", () => {
        state.selectedIds = [];
        state.currentPage = 1;
        render();
      });
    });

    const searchBtn = document.querySelector("#searchButton");
    if (searchBtn) searchBtn.addEventListener("click", render);
    const decBtn = document.querySelector("#decreaseQuantity");
    if (decBtn) decBtn.addEventListener("click", () => stepQuantity(-1));
    const incBtn = document.querySelector("#increaseQuantity");
    if (incBtn) incBtn.addEventListener("click", () => stepQuantity(1));
    const saveQtyBtn = document.querySelector("#saveQuantity");
    if (saveQtyBtn) saveQtyBtn.addEventListener("click", saveQuantity);
    const resetBtn = document.querySelector("#resetFilters");
    if (resetBtn) resetBtn.addEventListener("click", resetFilters);

    els.stockGrid.addEventListener("click", (event) => {
      const pageButton = event.target.closest("[data-page]");
      if (pageButton) {
        state.currentPage = Number(pageButton.dataset.page);
        render();
        return;
      }

      const retryBtn = event.target.closest("[data-retry-line]");
      if (retryBtn) {
        const lineId = retryBtn.dataset.retryLine;
        openQuantity(lineId);
        return;
      }
    });

    els.stockGrid.addEventListener("change", (event) => {
      if (event.target.matches("[data-select-line]")) {
        toggleSelected(event.target.dataset.selectLine, event.target.checked);
      }

      if (event.target.matches("[data-select-all-visible]")) {
        selectVisible();
      }

      if (event.target.matches("[data-page-size]")) {
        state.pageSize = Number(event.target.value);
        state.currentPage = 1;
        render();
      }
    });

    const addToOrderBtn = document.querySelector("#addToOrder");
    if (addToOrderBtn) {
      addToOrderBtn.addEventListener("click", () => {
        const count = state.selectedIds.length;
        if (!count) return;
        toast(`Successfully queued ${count} line${count === 1 ? "" : "s"} to Order Pad`);
        state.selectedIds = [];
        render();
      });
    }

    const clearSelectionBtn = document.querySelector("#clearSelectionBtn");
    if (clearSelectionBtn) {
      clearSelectionBtn.addEventListener("click", () => {
        state.selectedIds = [];
        render();
        toast("Selection cleared");
      });
    }

    const clearAllBtn = document.querySelector("#clearAll");
    if (clearAllBtn) {
      clearAllBtn.addEventListener("click", () => {
        if (!stockLines.length) {
          toast("There are no out of stock items to clear");
          return;
        }
        if (els.clearAllDialog) els.clearAllDialog.showModal();
      });
    }

    if (els.confirmClearAll) {
      els.confirmClearAll.addEventListener("click", () => {
        const clearedCount = stockLines.length;
        stockLines = [];
        state.selectedIds = [];
        state.currentPage = 1;
        if (els.clearAllDialog) els.clearAllDialog.close();
        render();
        toast(`${clearedCount} item${clearedCount === 1 ? "" : "s"} cleared`);
      });
    }

    document.querySelectorAll("[data-close-clear-all]").forEach((button) => {
      button.addEventListener("click", () => els.clearAllDialog.close());
    });

    document.querySelectorAll("[data-close-quantity]").forEach((button) => {
      button.addEventListener("click", () => els.quantityDialog.close());
    });

    render();
  </script>
</body>

</html>
